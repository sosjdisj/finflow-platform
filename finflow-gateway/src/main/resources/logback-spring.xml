<?xml version="1.0" encoding="UTF-8"?>
<!--
  M15 网关日志：服务名固定 finflow-gateway，traceId 来自 Micrometer Tracing（WebFlux + reactor 上下文传播）。
  网关是链路起点，这里的 traceId 会经 traceparent 透传给 backend、渠道、风控。
-->
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="finflow"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%property{serviceName}] [%X{traceId:-}] [%X{spanId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
