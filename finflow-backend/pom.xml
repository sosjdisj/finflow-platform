<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.example</groupId>
	<artifactId>finflow-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>finflow-backend</name>
	<description>finflow-backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<mybatis-plus.version>3.5.17</mybatis-plus.version>
		<jjwt.version>0.12.6</jjwt.version>
		<archunit.version>1.5.1</archunit.version>
		<!-- M08 版本矩阵沿用 M01：SC 2025.1.4（Boot 4.1.x 官方支持）+ SCA 2025.1.0.0（同 train） -->
		<spring-cloud.version>2025.1.4</spring-cloud.version>
		<spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
	</properties>

	<!-- 与 finflow-gateway 同一套矩阵；BOM 顺序有意义：先 SC 后 SCA，SC patch 覆盖 SCA 传递引入的 2025.1.0 -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.alibaba.cloud</groupId>
				<artifactId>spring-cloud-alibaba-dependencies</artifactId>
				<version>${spring-cloud-alibaba.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- S33 通知中心：邮件渠道（SMTP 未配置时运行时降级为只记日志） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<!-- S35 审计日志：@Aspect 切面（@Audited 注解环绕打点）。
		     Boot 4 已移除 starter-aop：spring-aop 随 context 提供，这里只需 AspectJ 织入器 -->
		<dependency>
			<groupId>org.aspectj</groupId>
			<artifactId>aspectjweaver</artifactId>
		</dependency>
		<!-- MyBatis-Plus：选官方兼容 Spring Boot 4 的 starter -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<!-- MP 3.5.9+ 分页等 jsqlparser 相关插件独立成包 -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-jsqlparser</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<!-- 参数校验（Jakarta Validation + Hibernate Validator） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring Security：RBAC 鉴权（S05 起由 starter 提供安全过滤链与 BCrypt） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- BCrypt 密码哈希（S05 起已由 security starter 包含，显式保留供纯 crypto 场景） -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<!-- JWT 签发与校验（access token）；版本独立于 Spring 管理 -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<!-- 单测 Mock（断言 mappers 交互） -->
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- 安全测试支持（@WithMockUser 等） -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- MySQL 驱动 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Flyway 数据库迁移 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<!-- Redis -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<!-- Kafka -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>
		<!-- Boot 4 模块化：Kafka 自动配置（KafkaTemplate/Listener 容器）拆到独立构件 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-kafka</artifactId>
		</dependency>
		<!-- MinIO 对象存储（S38 文件中心） -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.5.17</version>
		</dependency>
		<!-- S40 可观测性：Actuator 指标端点 + Prometheus 格式输出（/actuator/prometheus） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- S40 OpenAPI：springdoc 3.x 适配 Boot 4（Swagger UI + /v3/api-docs） -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.1</version>
		</dependency>
		<!-- M08 渠道服务独立进程：backend 侧 Feign + LoadBalancer 调渠道服务（mode=remote 时生效） -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-loadbalancer</artifactId>
		</dependency>
		<!-- M08 注册与发现：backend、渠道服务都以 Nacos 为注册中心 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
		</dependency>
		<!-- M14 配置中心：运行时阈值（风控 / 限流 / 渠道参数）从 Nacos Config 读取并支持热刷新 -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
		</dependency>
		<!-- M08 流控 / 熔断 / 降级：Feign 调用渠道服务时由 Sentinel 包裹（feign.sentinel.enabled=true） -->
		<dependency>
			<groupId>com.alibaba.cloud</groupId>
			<artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
		</dependency>
		<!-- M15 链路追踪：Micrometer Tracing + OTel Bridge（W3C traceparent）。
		     不引 starter-opentelemetry，避免带上 OTLP 指标/日志 exporter（本机无 collector） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- M15 Feign 出口：MicrometerObservationCapability 自动把 traceparent 注入下游请求头 -->
		<dependency>
			<groupId>io.github.openfeign</groupId>
			<artifactId>feign-micrometer</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- S39 集成测试 Testcontainers（版本由 Boot 父 POM 管理；Testcontainers 2.x 起 mysql 模块改名 testcontainers-mysql） -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- M02 依赖体检：ArchUnit 静态架构规则（FreezingArchRule 冻结存量违规，保证构建仍绿） -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- 同源双进程：默认 repackage（主 jar）显式指定 backend 启动类，避免两个 @SpringBootApplication 冲突 -->
				<configuration>
					<mainClass>org.example.finflowbackend.FinflowBackendApplication</mainClass>
				</configuration>
				<executions>
					<!-- M08 同源双进程：同一份源码额外产出渠道服务可执行 jar（classifier=channel） -->
					<execution>
						<id>repackage-channel-service</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<classifier>channel</classifier>
							<mainClass>org.example.finflowchannel.ChannelServiceApplication</mainClass>
						</configuration>
					</execution>
					<!-- M11 同源双进程：额外产出风控服务可执行 jar（classifier=risk） -->
					<execution>
						<id>repackage-risk-service</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<classifier>risk</classifier>
							<mainClass>org.example.finflowrisk.RiskServiceApplication</mainClass>
						</configuration>
					</execution>
					<!-- M16 同源双进程：额外产出通知服务可执行 jar（classifier=notify） -->
					<execution>
						<id>repackage-notify-service</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<classifier>notify</classifier>
							<mainClass>org.example.finflownotify.NotifyServiceApplication</mainClass>
						</configuration>
					</execution>
					<!-- M17 同源双进程：额外产出批处理服务可执行 jar（classifier=batch） -->
					<execution>
						<id>repackage-batch-service</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<classifier>batch</classifier>
							<mainClass>org.example.finflowbatch.BatchServiceApplication</mainClass>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.springframework.boot</groupId>
									<artifactId>spring-boot-configuration-processor</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- S39 覆盖率：mvn test 即产出 target/site/jacoco/index.html -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
