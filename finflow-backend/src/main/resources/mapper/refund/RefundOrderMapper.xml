<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.finflowbackend.refund.mapper.RefundOrderMapper">

    <!-- S21 状态推进：行级锁当前读，保证回调与受理并发时读到最新状态 -->
    <select id="selectForUpdate" resultType="org.example.finflowbackend.refund.entity.RefundOrder">
        SELECT *
        FROM refund_order
        WHERE id = #{id}
        FOR UPDATE
    </select>
</mapper>
