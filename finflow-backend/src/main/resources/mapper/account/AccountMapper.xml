<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.finflowbackend.account.mapper.AccountMapper">

    <!-- S18 并发控制：资金变更前的行级锁读 -->
    <select id="selectForUpdate" resultType="org.example.finflowbackend.account.entity.Account">
        SELECT *
        FROM account
        WHERE id = #{id}
        FOR UPDATE
    </select>
</mapper>
