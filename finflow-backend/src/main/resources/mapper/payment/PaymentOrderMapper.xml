<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.finflowbackend.payment.mapper.PaymentOrderMapper">

    <!-- S21 防超退：发起退款时的行级锁读 -->
    <select id="selectForUpdate" resultType="org.example.finflowbackend.payment.entity.PaymentOrder">
        SELECT *
        FROM payment_order
        WHERE id = #{id}
        FOR UPDATE
    </select>
</mapper>